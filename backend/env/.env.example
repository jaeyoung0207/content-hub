########## 환경변수정보는 깃허브에 커밋하지 말 것! ##########
## 환경변수 설정 파일 예시(PLACEHOLDER 값들을 실제 값으로 변경하여 사용)
# 기동 프로파일 설정(local, dev, staging, prod)
SPRING_PROFILES_ACTIVE=dev
# JPA DDL 자동 설정(validate, update, create, create-drop)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# 유지보수 모드 설정(true/false)
MAINTENANCE_MODE=false
# 모니터링 및 관리용 유저/패스워드 설정
ACTUATOR_USER=ACTUATOR_USER_PLACEHOLDER
ACTUATOR_PASSWORD=ACTUATOR_PASSWORD_PLACEHOLDER
# 각 외부 API 키 및 토큰 설정
TMDB_API_TOKEN=TMDB_API_TOKEN_PLACEHOLDER
TMDB_API_KEY=TMDB_API_KEY_PLACEHOLDER
DEEPL_API_KEY=DEEPL_API_KEY_PLACEHOLDER
NAVER_CLIENT_ID=NAVER_CLIENT_ID_PLACEHOLDER
NAVER_CLIENT_SECRET=NAVER_CLIENT_SECRET_PLACEHOLDER
KAKAO_CLIENT_SECRET=KAKAO_CLIENT_SECRET_PLACEHOLDER
# JWT 비밀 키 설정
JWT_SECRET_KEY=JWT_SECRET_KEY_PLACEHOLDER
# 데이터베이스 접속 정보 설정
DB_URL=DB_URL_PLACEHOLDER
DB_USERNAME=DB_USERNAME_PLACEHOLDER
DB_PASSWORD=DB_PASSWORD_PLACEHOLDER
# Redis 접속 정보 설정
REDIS_HOST=REDIS_HOST_PLACEHOLDER
REDIS_PORT=REDIS_PORT_PLACEHOLDER
# 도메인 설정
DOMAIN=DOMAIN_PLACEHOLDER
# Postgres 컨테이너 DB생성용 값 설정
POSTGRES_DB=POSTGRES_DB_PLACEHOLDER
POSTGRES_USER=POSTGRES_USER_PLACEHOLDER
POSTGRES_PASSWORD=POSTGRES_PASSWORD_PLACEHOLDER
